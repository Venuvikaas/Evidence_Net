# EVIDENCE-Net environment template.
#
# Copy this file to `.env` and fill in machine-specific values. Never commit
# `.env`.

# Official local dataset directories (Phase 1).
#
# When empty, scripts resolve these from the execution-file parent directory:
#   TRAIN_DATA_DIR        -> <project-parent>/train
#   TEST_NOISY_LR_DIR     -> <project-parent>/Test_NoisyLR
# Set machine-specific absolute paths here if the datasets live elsewhere.
# Test_NoisyLR is isolated evaluation input and must never influence
# development decisions.
TRAIN_DATA_DIR=
TEST_NOISY_LR_DIR=
